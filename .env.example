# Meeting Assistant — configuration
# Copy to .env and edit:   copy .env.example .env   (Windows)   |   cp .env.example .env

# ---- LLM backend: "local" (Hugging Face models on your GPU) or "api" (Groq + Gemini) ----
LLM_BACKEND=local

# ---- Local models (LLM_BACKEND=local) ----
# Defaults below need a GPU with ~15 GB (e.g. Colab T4): 3B in 16-bit, then 7B in 4-bit.
REFINE_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct
REFINE_LOCAL_QUANT=16bit
DOC_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
DOC_LOCAL_QUANT=4bit
# 6-8 GB GPU (e.g. RTX 4050/4060 laptop): use 3B in 4-bit for both roles instead
# REFINE_LOCAL_QUANT=4bit
# DOC_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct
# Max prompt length in tokens for local models
LOCAL_MAX_INPUT=24000
# 1 = allow running local models on the CPU when no GPU is found (very slow)
LOCAL_ALLOW_CPU=0
# 1 = keep both models on the GPU instead of swapping (large GPUs only)
# LOCAL_KEEP_ALL=1
# Transcript lines per Stage A call (local default 100)
# STAGEA_CHUNK_LINES=100

# ---- Speech-to-text ----
# openai/whisper-tiny | -base | -small | -medium | -large-v3
WHISPER_MODEL=openai/whisper-small

# ---- Where Hugging Face caches model weights (several GB) ----
# HF_HOME=D:/hf_cache

# ---- Timezone for timestamps in the meeting record ----
MEETING_TZ=Asia/Kolkata

# ---- Optional: speaker labels (pyannote/speaker-diarization-3.1, gated) ----
# Accept the model's terms on Hugging Face, pip install pyannote.audio, then:
# HF_TOKEN=hf_...

# ---- API backend (LLM_BACKEND=api, or python app.py --api) ----
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# REFINE_MODEL=llama-3.3-70b-versatile
# DOC_MODEL=
# DOC_FALLBACK_MODEL=auto
