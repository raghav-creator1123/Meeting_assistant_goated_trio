# Meeting Assistant — Configuration
# Local GPU backend: Qwen2.5-3B (refinement) + Qwen2.5-7B-4bit (documentation)
# No API keys needed for the LLMs.

# ---- LLM Backend ----
LLM_BACKEND=local
LOCAL_ALLOW_CPU=1
REFINE_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct
REFINE_LOCAL_QUANT=4bit
# Qwen2.5-7B (4-bit) needs ~5.5 GB for weights alone and runs out of memory on a
# 6 GB GPU (RTX 4050 Laptop). Use the 3B model here; switch back on an 8 GB+ GPU.
# DOC_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
DOC_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct
DOC_LOCAL_QUANT=4bit
LOCAL_MAX_INPUT=24000

# ---- Speech-to-text (Whisper, downloaded from Hugging Face on first run) ----
# Options: openai/whisper-tiny  openai/whisper-base  openai/whisper-small
#          openai/whisper-medium  openai/whisper-large-v3
WHISPER_MODEL=openai/whisper-small

# ---- Model cache on D: (C: is nearly full; Qwen weights are several GB) ----
HF_HOME=D:/hf_cache

# ---- Timezone for timestamps in the meeting record ----
MEETING_TZ=Asia/Kolkata

# ---- Optional: speaker labels with pyannote (gated model) ----
# Accept pyannote/speaker-diarization-3.1 terms on Hugging Face, then set:
# HF_TOKEN=hf_your_token_here

# ---- API keys (only needed if you switch LLM_BACKEND back to "api") ----
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# REFINE_MODEL=llama-3.3-70b-versatile
# DOC_MODEL=
# DOC_FALLBACK_MODEL=auto
